# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Local dev + drizzle-kit: direct Neon/Postgres URL (pooled recommended).
# Production on Cloudflare Workers uses Hyperdrive (wrangler.toml [[hyperdrive]]), not this secret.
POSTGRES_URL="postgresql://[user]:[password]@[neon-host]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudflare Hyperdrive (apps/nextjs/wrangler.toml):
# 1. Neon dashboard → Connection string → "Pooled" → copy
# 2. Cloudflare → Hyperdrive → Create config → paste Neon origin URL
# 3. Copy Hyperdrive config ID into wrangler.toml `id = "..."` (binding HYPERDRIVE)
# 4. Optional: remove POSTGRES_URL from Worker secrets if only using Hyperdrive at runtime


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://next-auth.js.org/configuration/options#secret
BETTER_AUTH_SECRET='supersecret'

# Preconfigured Discord OAuth provider, works out-of-the-box
# @see https://next-auth.js.org/providers/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# In case you're using the Auth Proxy (apps/auth-proxy)
# AUTH_REDIRECT_PROXY_URL='https://auth.your-server.com/r'

# Blink — Hyperliquid builder code
# Builder wallet address (rokitg.eth) used to route trades and collect fees
NEXT_PUBLIC_BUILDER_ADDRESS='0xc7BcB2EeE9BbFbf875499960746Bc52B2E1A75C6'
# Fee in 0.1bps units — 100 = 0.01%. Must be ≤ the approved maxFeeRate.
NEXT_PUBLIC_BUILDER_FEE_BPS='100'

# Stripe — Blink Pro membership checkout + internal memberships dashboard
# Restricted live key (rk_live_…) or secret key (sk_live_…) — never expose publicly
STRIPE_SECRET_KEY=''
# Webhook signing secret — POST https://your-domain/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=''
# Cursor Stripe MCP: use a restricted test key (rk_test_...) in ~/.cursor/mcp.json if not using https://mcp.stripe.com OAuth
# Pro builder fee in 0.1bps units (70 = 0.007%)
BLINK_PRO_BUILDER_FEE_BPS='70'
# Optional temporary allowlist while Stripe webhooks are being finalized
BLINK_PRO_WALLET_ALLOWLIST=''
# Growth-mode campaign switch (1 = on, 0 = off)
NEXT_PUBLIC_GROWTH_MODE='0'
# Extra discount applied to all Pro plans when growth mode is enabled
BLINK_GROWTH_PRO_DISCOUNT_PCT='20'
# Referral rewards multiplier messaging during growth mode
BLINK_GROWTH_REFERRAL_MULTIPLIER='2'

# Privy (wallet auth) — two different keys in Privy dashboard (Settings → Clients → Web)
# App ID (cm…) — parent app identifier
NEXT_PUBLIC_PRIVY_APP_ID='cmpiqa62z001u0ck2clr1ic8p'
# Client ID (client-…) — required for @privy-io/react-auth; do NOT use the App ID here
NEXT_PUBLIC_PRIVY_CLIENT_ID='client-WY6ZYq2Ve9d4cAN4A4kvRV26jJwsodGMA8JrAk7XriopW'

# Twitter / X API v2 — OAuth 2.0 PKCE (wallet ownership claim)
# Consumer key and secret from the X developer portal. Bearer token is not used.
TWITTER_CLIENT_ID=''
TWITTER_CLIENT_SECRET=''

# Canonical app URL used to build X OAuth redirect URIs
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# Resend — internal team invite emails (superuser panel at /internal/team)
RESEND_API_KEY=''
# Verified sender, e.g. Blink <notifications@blinkperps.xyz>
RESEND_FROM_EMAIL=''

# Discord live activity alerts (signup, builder approval, first routed trade)
# Create a channel webhook in Discord → copy URL here. Optional @mention on each alert:
DISCORD_ACTIVITY_WEBHOOK_URL=''
DISCORD_ACTIVITY_PING_USER_ID=''
# Optional separate webhook for profile verification sightings
DISCORD_SIGHTINGS_WEBHOOK_URL=''
