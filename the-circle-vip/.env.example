# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# Public links
NEXT_PUBLIC_TELEGRAM_INVITE_URL=https://t.me/your_public_or_support_link
NEXT_PUBLIC_TWITTER_URL=https://x.com/yourhandle

# Whop → Circle claim (proprietary verifier)
# POST { email, telegramUsername?, whopReceipt? } → { inviteLink }
CLAIM_BACKEND_URL=
CLAIM_BACKEND_API_KEY=

# Stripe — prefer a restricted key (rk_test_… / rk_live_…)
STRIPE_SECRET_KEY=rk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from `pnpm stripe:seed` (EUR card prices; USDC list stays in product copy / metadata)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_SEMIANNUAL=price_...
# indicators.rokitg.com — one-time Indicators pack (.zip + video + aggr.trade templates)
STRIPE_PRICE_INDICATORS_PACK=price_...
# Legacy alias still read as fallback during rollout
STRIPE_PRICE_ADDON_INDICATORS=price_...
NEXT_PUBLIC_INDICATORS_URL=https://indicators.rokitg.com
# USD → EUR FX snapshot used for display + creating new EUR prices from USD list
USD_TO_EUR_RATE=0.865682

# Telegram — VIP group access
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (for Login Widget)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# VIP group/supergroup/channel chat id (bot must be admin with invite rights)
# For private groups: add bot as admin, then use a negative chat id like -100xxxxxxxxxx
TELEGRAM_CHAT_ID=

# Owner internal dashboard (internal.rokitg.com)
INTERNAL_USERNAME=rokitg
INTERNAL_PASSWORD=change-me-strong-password

# Cloudflare Zone Analytics (Traffic SoT — host-filtered like the CF dashboard)
CF_ACCOUNT_ID=72265998f8cf66e3ab4d88575895dd0d
CF_ZONE_ID=f285c305e0e75ad3c8f385e8e3e6273f
# Marketing Worker hosts. Shopify store/account CNAMEs are separate origins
# (shops.myshopify.com) — add them here only if you want CF analytics for those hostnames.
CF_TRAFFIC_HOSTS=rokitg.com,www.rokitg.com
# User API token with Zone → Analytics → Read (not account cfat_ deploy token)
CF_ANALYTICS_API_TOKEN=

# Shopify — Internet Culture storefront (store.rokitg.com / account.rokitg.com)
# Dev Dashboard app credentials (client_credentials → short-lived Admin token)
# App must be INSTALLED on the shop or token exchange returns app_not_installed.
# Recommended scopes: read_products,read_orders,read_customers,read_analytics,read_reports
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy static token (shpat_…) — overrides client credentials if set
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Canonical myshopify domain for Admin API (not the custom storefront host)
SHOPIFY_STORE_DOMAIN=tfrdn9-ku.myshopify.com
SHOPIFY_STOREFRONT_HOST=store.rokitg.com
SHOPIFY_API_VERSION=2026-07
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://store.rokitg.com
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=https://account.rokitg.com

# Cloudflare Workers — also put these in Worker secrets / Build vars
# After `pnpm cf:kv:create` + `pnpm deploy`, set NEXT_PUBLIC_APP_URL to your
# workers.dev URL or custom domain (buy/connect in Worker → Domains tab).
